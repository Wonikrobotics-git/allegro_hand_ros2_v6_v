<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="allegro_hand_v6_ros2_control" params="name prefix ros2_control_hardware_type io_interface_descriptor:='modbus_tcp:192.168.1.100:502' hand_id:='1' csv_logging:='false' csv_directory:='./data_logs'">
        <ros2_control name="${name}" type="system">
            <hardware>
                <xacro:if value="${ros2_control_hardware_type == 'mock_components'}">
                    <plugin>mock_components/GenericSystem</plugin>
                </xacro:if>
                <xacro:if value="${ros2_control_hardware_type == 'isaac'}">
                    <plugin>wr_topic_based_ros2_control/TopicBasedSystem</plugin>
                    <param name="joint_commands_topic">/isaac_joint_commands</param>
                    <param name="joint_states_topic">/isaac_joint_states</param>
                    <param name="sum_wrapped_joint_states">false</param>
                </xacro:if>
                <xacro:if value="${ros2_control_hardware_type == 'hardware' or ros2_control_hardware_type == 'physical_device'}">
                    <plugin>allegro_hand_v6_hardware/AllegroHandV6System</plugin>
                    <param name="io_interface_descriptor">${io_interface_descriptor}</param>
                    <param name="hand_id">${hand_id}</param>
                    <param name="csv_logging">${csv_logging}</param>
                    <param name="csv_directory">${csv_directory}</param>
                    <param name="torque_constant">0.00115</param>
                    <param name="torque_limit">0.1</param>
                </xacro:if>
            </hardware>

            <!-- Thumb (joint00 - joint03) -->
            <xacro:macro name="add_v6_joint" params="joint_id">
                <joint name="${prefix}${joint_id}">
                    <command_interface name="position"/>
                    <command_interface name="effort"/>
                    <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
                    <state_interface name="velocity"><param name="initial_value">0.0</param></state_interface>
                    <state_interface name="effort"><param name="initial_value">0.0</param></state_interface>
                </joint>
            </xacro:macro>

            <xacro:add_v6_joint joint_id="joint00"/>
            <xacro:add_v6_joint joint_id="joint01"/>
            <xacro:add_v6_joint joint_id="joint02"/>
            <xacro:add_v6_joint joint_id="joint03"/>

            <!-- Index Finger (joint10 - joint13) -->
            <xacro:add_v6_joint joint_id="joint10"/>
            <xacro:add_v6_joint joint_id="joint11"/>
            <xacro:add_v6_joint joint_id="joint12"/>
            <xacro:add_v6_joint joint_id="joint13"/>

            <!-- Middle Finger (joint20 - joint23) -->
            <xacro:add_v6_joint joint_id="joint20"/>
            <xacro:add_v6_joint joint_id="joint21"/>
            <xacro:add_v6_joint joint_id="joint22"/>
            <xacro:add_v6_joint joint_id="joint23"/>

            <!-- Ring Finger (joint30 - joint33) -->
            <xacro:add_v6_joint joint_id="joint30"/>
            <xacro:add_v6_joint joint_id="joint31"/>
            <xacro:add_v6_joint joint_id="joint32"/>
            <xacro:add_v6_joint joint_id="joint33"/>

            <!-- Pinky Finger (joint40 - joint43) -->
            <xacro:add_v6_joint joint_id="joint40"/>
            <xacro:add_v6_joint joint_id="joint41"/>
            <xacro:add_v6_joint joint_id="joint42"/>
            <xacro:add_v6_joint joint_id="joint43"/>
        </ros2_control>
    </xacro:macro>
</robot>
