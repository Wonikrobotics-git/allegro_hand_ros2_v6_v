<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>allegro_hand_v6_bringup</name>
  <version>1.0.0</version>
  <description>The allegro_hand_v6_bringup package provides launches and configurations for Allegro Hand V6 (5-finger 20-DOF hand).</description>
  
  <maintainer email="jijang@wonik.com">('c')void</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rclcpp</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>hardware_interface</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>position_controllers</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>diagnostic_aggregator</exec_depend>
  <!-- Optional Isaac mode requires wr_topic_based_ros2_control separately. -->

  <exec_depend>allegro_hand_control_msgs</exec_depend>
  <exec_depend>allegro_hand_io</exec_depend>
  <exec_depend>allegro_hand_position_effort_controller</exec_depend>
  <exec_depend>allegro_hand_utility</exec_depend>
  <exec_depend>rqt_forward_command_controller</exec_depend>
  
  <exec_depend>allegro_hand_v6_description</exec_depend>
  <exec_depend>allegro_hand_v6_hardware</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
